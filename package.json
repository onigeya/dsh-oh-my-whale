{
  "name": "dsh-oh-my-whale",
  "version": "0.1.0",
  "description": "鲸鲸（oh-my-whale）— DSH 记忆插件底座：可加载、可体检、可降级（Epic 1）",
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "prepare": "pnpm build",
    "pretest": "pnpm build",
    "test": "vitest run",
    "test:e2e": "vitest run test/e2e",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && node scripts/check-layers.mjs && eslint .",
    "gate": "node --experimental-strip-types scripts/gate.ts"
  },
  "dependencies": {
    "triviumdb": "0.9.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "pnpm@12.18.0",
  "license": "MIT"
}